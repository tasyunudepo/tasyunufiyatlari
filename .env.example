# ─────────────────────────────────────────────────────────────
# tasyunufiyatlari.com — Environment Variables (örnek)
# Bu dosya repo'ya commitlenir; gerçek değerler .env.local'a yazılır.
# Vercel'de env değişkenleri Production + Preview + Development
# scope'larına ayrı ayrı eklenir.
# ─────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"   # server-only

# Teklif endpoint'i için HMAC anahtarları (server-only, en az 32 bayt)
# Her ortamda ayrı ve rastgele değer kullanın; NEXT_PUBLIC_ öneki eklemeyin.
QUOTE_ABUSE_HASH_SECRET="<en-az-32-bayt-rastgele-deger>"
PDF_CAPABILITY_SECRET="<en-az-32-bayt-farkli-rastgele-deger>"
PDF_UPLOAD_CAPABILITY_TTL_SECONDS=600
QUOTE_PDF_SIGNED_URL_TTL_SECONDS=900

# ─── Admin Panel (Basic Auth — middleware.ts) ────────────────
# /ofis ve /api/admin/* rotalarını korur.
ADMIN_USER=admin                   # opsiyonel, default 'admin'
ADMIN_PASSWORD=change-me-strong    # zorunlu (yoksa admin girişi imkânsız)
PATRON_PASSWORD=                   # opsiyonel — 'patron' kullanıcısı için

# ─── CallmeBot (WhatsApp notifications) ──────────────────────
CALLMEBOT_PHONE_2=
CALLMEBOT_APIKEY_2=

# ─── Google Analytics 4 ──────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
