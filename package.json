{
  "name": "tasyunu-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:db:quote-guard": "bash scripts/verify-quote-guard-db.sh && bash scripts/verify-comparison-attribution-db.sh",
    "verify:acceptance": "node scripts/verify-acceptance-lock.mjs",
    "verify:live:readonly": "node --env-file=.env.local scripts/verify-p0-live-readonly.mjs",
    "verify:visitor-copy": "bash scripts/verify-visitor-copy.sh",
    "verify:fast": "vitest run && tsc --noEmit",
    "verify:full": "vitest run && tsc --noEmit && eslint && next build",
    "verify:release": "bash scripts/verify-p0-release.sh",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "verify:contrast": "node scripts/audit-contrast.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.561.0",
    "next": "^16.3.3",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.8",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
